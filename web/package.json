{
  "name": "astral-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && tsx scripts/prepare-standalone.ts",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "tsx scripts/smoke-standalone.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/admin.ts",
    "api:generate": "openapi-typescript ../contracts/harness.openapi.json -o src/lib/harness-schema.d.ts && tsx scripts/generate-routes.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.2",
    "katex": "^0.19.1",
    "mysql2": "^3.14.1",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
